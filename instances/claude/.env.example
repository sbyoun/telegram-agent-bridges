BRIDGE_PROVIDER=claude
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_ALLOWED_CHAT_IDS=123456789
# Telegram user ids allowed to drive the bridge. Defaults to the chat ids
# above (private chat: user id == chat id). REQUIRED for group chats —
# otherwise every group member could run commands.
# TELEGRAM_ALLOWED_USER_IDS=123456789
CLAUDE_WORKDIR=/home/ubuntu
CLAUDE_BIN=/home/ubuntu/.local/bin/claude
# CLAUDE_MODEL=
CLAUDE_EXTRA_ARGS=
# Run the CLI with --permission-mode bypassPermissions
# --dangerously-skip-permissions. Off by default: headless -p runs cannot
# answer permission prompts, so without this the agent is effectively
# read-only. Only enable on a private, allowlisted chat.
# CLAUDE_BYPASS_PERMISSIONS=1
# Restrict /cd to these roots (comma-separated). Unset = unrestricted.
# BRIDGE_CD_ROOTS=/home/ubuntu
# Hide sessions whose cwd is under these paths from /sessions
# (comma-separated). No filtering by default.
# CLAUDE_EXCLUDE_CWDS=/home/ubuntu/loop-engine
TELEGRAM_PLAIN_TEXT_AS_RUN=1
TELEGRAM_POLL_TIMEOUT=20
