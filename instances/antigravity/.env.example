# Antigravity (agy) instance — successor to the deprecated Gemini CLI bridge.
# Copy to .env and set TELEGRAM_BOT_TOKEN before enabling.
BRIDGE_PROVIDER=antigravity
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_ALLOWED_CHAT_IDS=123456789
# Telegram user ids allowed to drive the bridge. Defaults to the chat ids
# above (private chat: user id == chat id). REQUIRED for group chats —
# otherwise every group member could run commands.
# TELEGRAM_ALLOWED_USER_IDS=123456789
ANTIGRAVITY_WORKDIR=/home/ubuntu
ANTIGRAVITY_BIN=/home/ubuntu/.local/bin/agy
# Model is configured inside agy's own settings.json (no --model flag), so
# ANTIGRAVITY_MODEL is ignored by the provider.
# ANTIGRAVITY_MODEL=
ANTIGRAVITY_EXTRA_ARGS=
# Run agy with --dangerously-skip-permissions. Off by default: a
# non-interactive --print run cannot answer permission prompts. Only enable
# on a private, allowlisted chat.
# ANTIGRAVITY_BYPASS_PERMISSIONS=1
# Restrict /cd to these roots (comma-separated). Unset = unrestricted.
# BRIDGE_CD_ROOTS=/home/ubuntu
TELEGRAM_PLAIN_TEXT_AS_RUN=1
TELEGRAM_POLL_TIMEOUT=20
